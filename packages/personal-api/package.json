{
  "name": "garmin-personal-api",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for Garmin's official Garmin Connect Personal API. Not affiliated with Garmin.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "fetch-spec": "node scripts/fetch-spec.mjs",
    "gen": "node scripts/patch-spec.mjs && openapi-typescript spec/personal-api.v1.structure.json --output src/types.gen.ts --root-types --root-types-no-schema-prefix --alphabetize",
    "check-spec": "node scripts/check-spec.mjs && node scripts/check-spec.mjs --patched",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
